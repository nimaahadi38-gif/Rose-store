# ═══════════════════════════════════════════════════════════════
# فایل نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید
# هرگز مقادیر واقعی را در این فایل قرار ندهید
# ═══════════════════════════════════════════════════════════════

# ─── محیط اجرا ────────────────────────────────────────────────
# مقادیر مجاز: production | development
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran

# ─── ربات تلگرام ──────────────────────────────────────────────
# توکن دریافتی از @BotFather
BOT_TOKEN=123456:ABCDEF_replace_me

# آی‌دی عددی Super Admin (سازنده ربات)
ADMIN_ID=000000000

# لیست آی‌دی‌های ادمین‌های اضافی با کاما جدا شوند (اختیاری)
EXTRA_ADMIN_IDS=

# ─── پروکسی SOCKS5 (برای هاست داخل ایران) ────────────────────
# اگر روی سرور خارجی هستید این مقادیر را خالی بگذارید
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=

# ─── دیتابیس MySQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vpnbot
DB_USER=vpnbot
DB_PASS=replace_me
DB_CHARSET=utf8mb4

# ─── Long Polling ─────────────────────────────────────────────
# طول مکث getUpdates بر حسب ثانیه
POLL_TIMEOUT=30
# حداکثر تعداد آپدیت در هر سیکل
POLL_LIMIT=100

# ─── ابزار عیب‌یابی ───────────────────────────────────────────
# توکن دسترسی به bin/diagnose.php — یک رشتهٔ تصادفی طولانی
DIAG_TOKEN=

# ─── لاگ ──────────────────────────────────────────────────────
# سطح: debug | info | warning | error
LOG_LEVEL=info
LOG_TO_STDOUT=true
